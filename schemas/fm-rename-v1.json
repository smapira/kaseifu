{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fm-rename-v1",
  "title": "FmRenameContract",
  "type": "object",
  "required": [
    "schema_version"
  ],
  "oneOf": [
    {
      "title": "Request",
      "required": [
        "schema_version",
        "request_id",
        "target_type",
        "path",
        "language",
        "analysis",
        "input"
      ],
      "properties": {
        "input": {
          "type": "object",
          "properties": {
            "image": {
              "type": "object",
              "description": "Image facts already extracted in Rust (EXIF / Spotlight)."
            },
            "perception": {
              "type": "object",
              "description": "Phase 5b: bounded Apple Vision labels. Optional and image-only; nothing is required and no existing key changes.",
              "properties": {
                "labels": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "object",
                    "required": [
                      "label",
                      "confidence"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "confidence": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "Response",
      "required": [
        "schema_version",
        "request_id",
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "error",
            "cancelled"
          ]
        }
      }
    },
    {
      "title": "Availability",
      "required": [
        "schema_version",
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "unavailable"
          ]
        }
      }
    },
    {
      "title": "Available",
      "required": [
        "schema_version",
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "available"
          ]
        }
      }
    }
  ]
}
